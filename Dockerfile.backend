# 어떤 Base Image를 사용할 것인가
FROM python:3.10-slim

# 컨테이너 내부 작업 디렉터리
# (레포 전체를 /app 에 복사하고, backend/ 로 이동해서 실행합니다.
#  config.py의 BASE_DIR(프로젝트 루트) 경로 계산이 그대로 맞도록
#  backend/ 폴더 구조를 이미지 안에서도 유지합니다)
WORKDIR /app

# 로컬 코드를 컨테이너에 복사 (requirements.txt는 프로젝트 루트에 있음)
COPY requirements.txt .

# PyTorch를 명시된 cu124 버전으로 우선 설치
# (sentence-transformers 등이 requirements.txt 설치 과정에서 CPU 전용 torch를
#  임의로 끌어오지 않도록, CUDA 지원 버전을 먼저 고정 설치합니다)
RUN pip install torch==2.6.0 torchvision==0.21.0 --extra-index-url https://download.pytorch.org/whl/cu124

# 나머지 의존성 패키지 설치
RUN pip install -r requirements.txt

# 나머지 코드 복사 (data/, backend/, frontend/ 등 레포 전체)
COPY . .

# 이후 명령은 backend/ 안에서 실행 (main.py, agent_main.py, config.py 등이 이 폴더 안에 있음)
WORKDIR /app/backend

# 컨테이너 시작 시 실행할 명령
#   1) build_db.py 로 Chroma DB를 (재)생성 - data/ 폴더 내용 기준으로 항상 최신 상태 유지
#      (Ollama가 호스트에서 이미 떠 있고 bge-m3 / qwen2.5:14b가 pull 되어 있어야 함)
#   2) uvicorn 으로 FastAPI 서버 기동
CMD ["sh", "-c", "python build_db.py && uvicorn main:app --host 0.0.0.0 --port 8000"]
